"scenario.competitor_brief.title" = "Create a competitor brief";
"scenario.competitor_brief.subtitle" = "Get a comparison draft ready for discussion.";
"scenario.competitor_brief.outcome" = "Create an internal competitor brief in 30 minutes.";
"scenario.competitor_brief.quick_step_1" = "Set the products and time window.";
"scenario.competitor_brief.quick_step_2" = "Copy the template to generate a draft.";
"scenario.competitor_brief.quick_step_3" = "Verify the sources behind each conclusion.";
"scenario.competitor_brief.step_1.title" = "Define comparison dimensions";
"scenario.competitor_brief.step_1.detail" = "Fix features, pricing, target users, and growth strategy as the initial dimensions.";
"scenario.competitor_brief.step_2.title" = "Collect and consolidate";
"scenario.competitor_brief.step_2.detail" = "Use research tools to collect material, then let AI normalize the structure.";
