{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningMaterials",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "summary",
      "core_capabilities",
      "getting_started",
      "official_links",
      "caveats",
      "last_verified_at",
      "review_status"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "summary": { "type": "string", "minLength": 1 },
      "core_capabilities": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "getting_started": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "official_links": {
        "type": "array",
        "items": { "type": "string", "pattern": "^https://.+" }
      },
      "caveats": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      },
      "last_verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "review_status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
      "review_note": { "type": "string" }
    },
    "additionalProperties": true
  }
}
